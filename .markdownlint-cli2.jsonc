// Recommended markdownlint configuration for Gramaire grammar files.
//
// Philosophy: relax line-length where a formal grammar legitimately needs
// the room, and keep EVERY rule that protects how the file renders on
// GitHub or that guards against unsafe markup. markdownlint-cli2 discovers
// this file automatically, so it supplies the ruleset to both
// `gramaire --check <file>` (which lints exactly that file) and CI.
//
// No `globs` key on purpose: markdownlint-cli2 merges config globs with any
// paths passed on the command line, which would make the per-file lint gate
// also lint every other grammar in the repo. CI passes the globs it wants
// explicitly; the gate passes a single file.
//
// Trade-off worth knowing: because line-length is relaxed here, a Gramaire
// file dropped into a repo whose own config enforces strict MD013 may warn
// on long lines there. That is the deliberate, pragmatic choice — long
// productions and wide FIRST/FOLLOW rows should not be forced to wrap.
{
  "config": {
    "default": true,

    // --- relaxed: formal grammars and generated tables run long ----------
    "MD013": {
      "line_length": 120, // generous prose cap (default is 80)
      "code_blocks": false, // never measure length inside gramaire fence
      // payloads — actions and rules are free to be
      // as wide as they need to be
      "tables": false, // FIRST / FOLLOW / conflict rows can be wide
      "headings": false,
    },

    // --- relaxed: ergonomics --------------------------------------------
    "MD024": { "siblings_only": true }, // a heading text may repeat under
    // different parent sections

    // `gramaire fmt`'s default source-collapsing (sidecar mode) is the only thing that ever emits
    // raw HTML — a `<details><summary>Source</summary>` disclosure wrapped around a rule's fence
    // — so MD033 stays the injection guard for everything else and only allow-lists those two
    // tags, rather than being switched off wholesale.
    "MD033": { "allowed_elements": ["details", "summary"] },

    // MD060 table-column-style: disabled because ADR rationale cells in
    // docs/ run hundreds of characters — aligning pipes to header widths
    // is not feasible, and the rule is not load-bearing for rendering.
    "MD060": false,

    // --- KEPT AT DEFAULT (load-bearing — do not disable) ----------------
    // These stay on via "default": true and must never be turned off:
    //   MD033 no-inline-html : scoped above to `details`/`summary` only — every OTHER tag stays
    //                          blocked. GitHub sanitizes raw HTML, and this rule is also the
    //                          injection guard — diagrams are linked images, never embedded <svg>.
    //   MD040 fenced-language: every fence carries an info string (lr, ...).
    //   MD022 / MD031 / MD032 / MD058 : blank lines around headings, fences,
    //                          lists, and tables — required for correct
    //                          rendering on GitHub.
    //   MD010 no-hard-tabs   : payload indentation must be spaces.
    //   MD041 / MD025        : exactly one H1, and it is the first line.
    //   MD047                : single trailing newline.
  },
  // Honour .gitignore so build output (output/, .spago/) and node_modules —
  // which contain third-party Markdown — are never linted. `vendor/` holds
  // third-party submodules (e.g. antlr-ng), tracked but not ours to lint.
  // `design/gramark-site-handoff/` is an external design handoff imported
  // byte-verbatim (see design/README.md) — same rationale as vendor/.
  "gitignore": true,
  "ignores": ["**/node_modules/**", "vendor/**", "design/gramark-site-handoff/**"],
}
