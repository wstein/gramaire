{
  "name": "gramaire-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "gh-pages -d dist",
    "test": "tsx --test src/lib/gramaire-runtime.test.ts",
    "build:engine": "cd .. && sbt playground/fullLinkJS && cp playground/js/target/scala-3.4.2/gramaire-playground-opt/main.js site/src/generated/gramaire-engine.mjs",
    "check:engine": "npm run build:engine && git diff --exit-code src/generated/gramaire-engine.mjs",
    "format": "prettier --write \"src/**/*.{ts,astro,md,mdx}\" \"*.{json,md,mjs}\"",
    "lint": "prettier --check \"src/**/*.{ts,astro,md,mdx}\" \"*.{json,md,mjs}\""
  },
  "dependencies": {
    "@astrojs/starlight": "^0.41.1",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "astro": "^7.0.3",
    "gh-pages": "^6.0.0"
  },
  "devDependencies": {
    "prettier": "^3.5.0",
    "prettier-plugin-astro": "^0.14.1",
    "tsx": "^4.19.2"
  }
}
