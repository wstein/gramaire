  },
  "dependencies": {
    "@astrojs/starlight": "^0.30.6",
    "astro": "^5.0.0",
    "gh-pages": "^6.0.0"
  },
  "devDependencies": {
    "prettier": "^3.5.0",
    "tsx": "^4.19.2"
  }
}
