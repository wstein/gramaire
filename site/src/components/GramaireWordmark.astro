---
// The Gramaire wordmark — treatment "02 · Split stem" from the handoff. The
// name is a portmanteau (grammar + grimoire) whose single shared middle `m`
// is the brand hinge: `Gra` inks in `--fg`, `aire` in `--accent`, and the `m`
// is bisected left-half `--fg` / right-half `--accent` by a hard-stop text
// gradient. One weight/size throughout (IBM Plex Sans 700, tight tracking).
interface Props {
  size?: string;
  class?: string;
}
const { size = "1.25rem", class: klass } = Astro.props;
---

<span class:list={["gramaire-wordmark", klass]} style={`--wm-size: ${size}`}>
  <span class="wm-gra">Gra</span><span class="wm-m">m</span><span class="wm-aire"
    >aire</span
  >
</span>

<style>
  .gramaire-wordmark {
    font-family: var(--font-ui, "IBM Plex Sans", sans-serif);
    font-weight: 700;
    font-size: var(--wm-size);
    letter-spacing: -0.04em;
    line-height: 1;
    white-space: nowrap;
    display: inline-flex;
  }
  .wm-gra {
    color: var(--gramaire-fg, var(--fg, #16181d));
  }
  .wm-aire {
    color: var(--accent, #0a8f63);
  }
  .wm-m {
    background: linear-gradient(
      90deg,
      var(--gramaire-fg, var(--fg, #16181d)) 0 50%,
      var(--accent, #0a8f63) 50% 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
  }
</style>
