---
// The Gramaire wordmark.
// The brand hinges on two colors: `Gram` inks in `--fg`, and `aire` in `--accent`.
// One weight/size throughout (IBM Plex Sans 700, tight tracking).
interface Props {
  size?: string;
  class?: string;
}
const { size = "1.25rem", class: klass } = Astro.props;
---

<span class:list={["gramaire-wordmark", klass]} style={`--wm-size: ${size}`}>
  <span class="wm-gram">Gram</span><span class="wm-aire">aire</span>
</span>

<style>
  .gramaire-wordmark {
    font-family: var(--font-ui, "IBM Plex Sans", sans-serif);
    font-weight: 700;
    font-size: var(--wm-size);
    letter-spacing: -0.04em;
    line-height: 1;
    white-space: nowrap;
    display: inline-flex;
  }
  .wm-gram {
    color: var(--gramaire-fg, var(--fg, #16181d));
  }
  .wm-aire {
    color: var(--accent, #0a8f63);
  }
</style>
