---
// Overrides Starlight's default site title with the logomark + split-stem
// wordmark lockup (mock spec: design/gramark-site-handoff/README.md →
// "Global Shell"). See https://starlight.astro.build/guides/customization/#site-title
import type { Props } from "@astrojs/starlight/props";
import Logomark from "./Logomark.astro";
import Wordmark from "./Wordmark.astro";

const { siteTitleHref } = Astro.props as Props;
---

<a href={siteTitleHref} class="site-title-lockup">
  <Logomark size={26} />
  <Wordmark />
</a>

<style>
  .site-title-lockup {
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: 17px;
    text-decoration: none;
  }
</style>
