---
// The sticky brand topbar for the standalone pages (Landing, Lab) that live
// outside Starlight's chrome: logomark + split-stem wordmark (→ Home), the
// Home · Tutorial · Docs · Lab nav (active item in --accent), and the mock's
// pill theme switch. The switch persists to `starlight-theme` — the same key
// Starlight's own toggle uses — so a choice here carries across to the docs.
import GramaireMark from "./GramaireMark.astro";
import GramaireWordmark from "./GramaireWordmark.astro";

interface Props {
  active?: "home" | "tutorial" | "docs" | "lab";
}
const { active } = Astro.props as Props;
const base = import.meta.env.BASE_URL;
const nav = [
  { id: "home", label: "Home", href: base },
  { id: "tutorial", label: "Tutorial", href: `${base}tutorials/intro/` },
  { id: "docs", label: "Docs", href: `${base}docs/overview/` },
  { id: "lab", label: "Lab", href: `${base}lab` },
];
---

<header class="topbar">
  <a href={base} class="brand" aria-label="Gramaire — home">
    <GramaireMark size={26} />
    <GramaireWordmark size="1.2rem" />
  </a>
  <nav class="nav">
    {
      nav.map((item) => (
        <a
          href={item.href}
          class:list={["nav-link", { active: active === item.id }]}
        >
          {item.label}
        </a>
      ))
    }
    <span class="divider"></span>
    <button
      type="button"
      class="theme-switch"
      id="theme-switch"
      role="switch"
      aria-label="Toggle dark mode"
      aria-checked="false"
    >
      <span class="sun">☀</span>
      <span class="knob"></span>
      <span class="moon">☾</span>
    </button>
  </nav>
</header>

<style>
  .topbar {
    position: sticky;
    top: 0;
    z-index: 20;
    height: 54px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 1.25rem;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
  }
  .nav {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .nav-link {
    font-size: 0.9rem;
    color: var(--fg-muted);
    text-decoration: none;
    font-weight: 500;
  }
  .nav-link:hover {
    color: var(--fg);
  }
  .nav-link.active {
    color: var(--accent);
    font-weight: 600;
  }
  .divider {
    width: 1px;
    height: 22px;
    background: var(--border-strong);
  }
  .theme-switch {
    position: relative;
    width: 46px;
    height: 25px;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
    background: var(--bg-2);
    cursor: pointer;
    padding: 0;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    font-size: 11px;
    color: var(--fg-faint);
  }
  .theme-switch .sun {
    margin-left: 4px;
  }
  .theme-switch .moon {
    margin-right: 4px;
  }
  .theme-switch .knob {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 19px;
    height: 19px;
    border-radius: 50%;
    background: var(--accent);
    transition: transform 0.22s ease;
  }
  :global([data-theme="dark"]) .theme-switch .knob {
    transform: translateX(21px);
  }
  @media (max-width: 560px) {
    .nav {
      gap: 0.6rem;
    }
    .nav-link {
      font-size: 0.82rem;
    }
  }
</style>

<script>
  const root = document.documentElement;
  const sw = document.getElementById("theme-switch");
  const sync = () =>
    sw?.setAttribute(
      "aria-checked",
      root.dataset.theme === "dark" ? "true" : "false",
    );
  sw?.addEventListener("click", () => {
    const next = root.dataset.theme === "dark" ? "light" : "dark";
    root.dataset.theme = next;
    try {
      localStorage.setItem("starlight-theme", next);
    } catch {
      /* storage blocked — the toggle still works for this page view */
    }
    sync();
  });
  sync();
</script>
