---
// The Gramaire logomark: a railroad / syntax-diagram production rule — an entry
// track (dot + line) meets an emerald rule-node (stadium rect) that forks into
// two alternatives (curved tracks ending in terminal dots). Geometry is the
// handoff spec verbatim (96×96, stroke 7.5, round caps).
//
// Theme-aware: the ink (tracks, dots, node outline) is `currentColor`, so a
// caller sets it via `color`/`--gramaire-fg` and it flips in dark mode; the node
// fill stays a constant emerald (`--node`). `knockout` is the white-on-emerald
// variant for the filled app/social tile (node fill goes transparent).
interface Props {
  size?: number;
  knockout?: boolean;
  class?: string;
}
const { size = 28, knockout = false, class: klass } = Astro.props;
const ink = knockout ? "#ffffff" : "currentColor";
const nodeFill = knockout ? "transparent" : "var(--node, #15b879)";
---

<svg
  width={size}
  height={size}
  viewBox="0 0 96 96"
  fill="none"
  stroke={ink}
  stroke-width="7.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  role="img"
  aria-label="Gramaire"
  class={klass}
  style={`color: var(--gramaire-fg, currentColor)`}
>
  <!-- entry track -->
  <path d="M11 48 H28"></path>
  <circle cx="11" cy="48" r="5" fill={ink} stroke="none"></circle>
  <!-- fork up / down -->
  <path d="M62 48 C72 48 73 13 85 13"></path>
  <path d="M62 48 C72 48 73 83 85 83"></path>
  <circle cx="85" cy="13" r="5" fill={ink} stroke="none"></circle>
  <circle cx="85" cy="83" r="5" fill={ink} stroke="none"></circle>
  <!-- rule node -->
  <rect x="26" y="30" width="36" height="36" rx="18" fill={nodeFill}></rect>
</svg>
