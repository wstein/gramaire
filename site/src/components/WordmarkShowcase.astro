---
// Wordmark specimen tile, for the brand book page.
import Wordmark from "./Wordmark.astro";
---

<div class="tile">
  <Wordmark />
</div>

<style>
  .tile {
    display: inline-flex;
    width: fit-content;
    font-size: 40px;
    padding: 24px 32px;
    background: var(--bg-1);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    margin: 24px 0;
  }
</style>
