---
// A single rule's railroad diagram, rendered inline (not an <img>) at build
// time by the same real renderer the Lab uses. Inline means the SVG's `--rr-*`
// inks inherit the page theme, so it flips in dark mode — unlike a static
// <img>, whose SVG can't see the page's CSS variables. Used for the tutorial's
// reference diagrams.
import {
  parseGramaireDocument,
  renderDiagrams,
} from "../generated/site-glue.mjs";

interface Props {
  grammar: string;
  rule: string;
  caption?: string;
}
const { grammar, rule, caption } = Astro.props as Props;

// Parse once to learn the grammar's nonterminals, so references inside this
// rule colour as nonterminals (not terminals) in the diagram.
const { rules } = await parseGramaireDocument(grammar);
const svg =
  renderDiagrams(grammar, rules).find((d) => d.name === rule)?.svg ?? "";
---

<figure class="rule-diagram">
  <div class="rd-svg" set:html={svg} />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .rule-diagram {
    margin: 1rem 0;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-1);
    padding: 0.6rem 0.8rem;
    overflow: auto;
  }
  .rd-svg :global(svg) {
    max-width: 100%;
    height: auto;
  }
  figcaption {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--fg-faint);
    margin-top: 0.4rem;
  }
</style>
