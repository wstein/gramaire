---
// Gramaire wordmark: `Gram` in ink, `aire` in accent.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<span
  class={className}
  style="font-weight:700;letter-spacing:-0.04em;line-height:1;white-space:nowrap;font-size:inherit;font-family:'IBM Plex Sans',ui-sans-serif,system-ui,sans-serif"
>
  <span style="color:var(--fg)">Gram</span><span style="color:var(--accent)"
    >aire</span
  >
</span>
