---
// Split-stem wordmark, ported verbatim from the gold-standard mock
// (design/gramark-site-handoff/GramarkWordmark.dc.html). "Gra" = ink, the
// shared middle "m" is bisected ink/accent via a hard-stop text gradient,
// "ark" = accent. See docs/BRANDING.md → Wordmark for the rationale.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<span
  class={className}
  style="font-weight:700;letter-spacing:-0.04em;line-height:1;white-space:nowrap;font-size:inherit;font-family:'IBM Plex Sans',ui-sans-serif,system-ui,sans-serif"
>
  <span style="color:var(--fg)">Gra</span><span
    style="background:linear-gradient(90deg,var(--fg) 0 50%,var(--accent) 50% 100%);-webkit-background-clip:text;background-clip:text;color:transparent;-webkit-text-fill-color:transparent"
    >m</span
  ><span style="color:var(--accent)">ark</span>
</span>
