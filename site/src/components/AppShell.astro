---
// The single, unified topbar for every route — Starlight pages (Docs,
// Specs, Tutorials, Brand) via the `Header` component override in
// astro.config.mjs, and the bare Landing page directly. Rendering itself is
// delegated to the shared <gramark-topbar> custom element
// (../shared/gramark-topbar.mjs): a real Shadow DOM boundary instead of two
// independent Astro composition paths, which is what caused Starlight's own
// `.header` wrapper to double up on padding and an ancestor-attribute
// selector (`[data-theme="dark"] .knob`) to silently never match under
// Astro's per-file style scoping. This component's only job is the Astro-side
// concerns the custom element can't do itself: computing which nav section is
// active from the current route, resolving the deploy base path, and
// providing Starlight's own `<Search />` (so Pagefind indexing keeps working)
// as the slotted `tools` content.
import Search from "@astrojs/starlight/components/Search.astro";

type NavId = "home" | "tutorial" | "docs" | "lab";

// Auto-detect from the URL rather than requiring every caller (Landing,
// every Starlight page) to pass it explicitly — this component is also
// Starlight's Header override, and Starlight doesn't know about our nav's
// id scheme to pass one in.
//
// `Astro.url.pathname` includes the deployed base path (astro.config.mjs's
// `base = process.env.CI ? "/gramark/" : "/"`, exposed here as
// `import.meta.env.BASE_URL`) — strip it before matching, and anchor every check to a real path
// SEGMENT rather than a bare substring. Two bugs this fixes together: the home check (`path ===
// "/"`) never matched once `base` was non-empty, so the real GitHub Pages deployment never
// highlighted Home as current at all; the other checks' unanchored `.includes(...)` could
// false-positive on any future route merely containing one of these substrings (a hypothetical
// "/labyrinth/" route would have matched the Lab check).
function detectActive(pathname: string, base: string): NavId | null {
  const rel = pathname.startsWith(base)
    ? pathname.slice(base.length)
    : pathname;
  const path = "/" + rel.replace(/^\/+/, "");
  if (path === "/" || path === "/index.html") return "home";
  if (/^\/tutorials(\/|$)/.test(path)) return "tutorial";
  if (/^\/(docs|specs|brand)(\/|$)/.test(path)) return "docs";
  if (/^\/lab(\/|$)/.test(path)) return "lab";
  return null;
}
const active = detectActive(Astro.url.pathname, import.meta.env.BASE_URL);

// Pagefind indexes rendered page content, and the Lab is an interactive
// tool with no indexable content of its own (its "content" is whatever
// grammar/input the visitor is currently typing) — a search box there
// invites a query that can never return a real result, which read as
// broken/confusing rather than merely unhelpful. Every other section has
// real Pagefind-indexed content behind it.
const showSearch = active !== "lab";
---

<gramark-topbar active={active} base={import.meta.env.BASE_URL}>
  {
    showSearch && (
      /*
        `slot="tools"` on <Search/> itself would be consumed by Astro's OWN
        component-slotting (it has no matching named <slot> to project into),
        not forwarded as a literal HTML attribute on the rendered <site-search>
        — the same gotcha FlatBars' Topbar.astro documents for its sidebar
        toggle. A plain wrapping element isn't an Astro component, so Astro
        passes its `slot` attribute through literally.
      */
      <div slot="tools">
        <Search />
      </div>
    )
  }
</gramark-topbar>

<script>
  import "../shared/gramark-topbar.mjs";
</script>
