---
// The shared live-edit island: a grammar editor beside its railroad diagrams,
// redrawn on every keystroke by the *real* engine (the same `Gramark.Playground`
// core the CLI runs), plus — when a sample `input` is given — a live
// accept/reject verdict and the lexed token stream. "Open in Lab ↗" hands the
// *current* (edited) grammar to the full Lab through the URL hash, so the
// payload never hits the network.
//
// This is the design's "one file · edit the source" showcase, packaged for
// reuse on the Landing hero and at each Tutorial step. It is framework-free
// (a vanilla client `<script>` wires every instance), matching the site's
// no-UI-framework convention. Usage in .mdx / .astro:
//   <LiveGrammar grammar={`Expr\n  : Expr '+' Term\n  | Term\n`} input="num" />
import { labGrammarHref } from "../lib/lab-link.ts";

interface Props {
  /** The seed grammar (`.grmk` projection or fenced `.grmk.md`). */
  grammar: string;
  /** Optional sample input; when present, shows a live accept/reject verdict. */
  input?: string;
  /** Header label; defaults to the design's "try it — live". */
  caption?: string;
}
const { grammar, input, caption = "try it — live" } = Astro.props as Props;
const base = import.meta.env.BASE_URL;
const labHref = labGrammarHref(base, grammar, input);
const hasInput = input != null;
---

<div
  class="live-grammar"
  data-base={base}
  data-has-input={hasInput ? "1" : "0"}
>
  <div class="lg-hd">
    <span class="lg-label">{caption}</span>
    <a class="lg-lab" href={labHref}>Open in Lab ↗</a>
  </div>
  <div class="lg-grid">
    <textarea class="lg-src" spellcheck="false" aria-label="Grammar source"
      >{grammar}</textarea
    >
    <div class="lg-out">
      <div class="lg-cap">renders to ↓</div>
      <div class="lg-diagrams">—</div>
    </div>
  </div>
  {
    hasInput && (
      <div class="lg-foot">
        <label class="lg-input-wrap">
          <span>input</span>
          <input
            class="lg-input"
            value={input}
            aria-label="Sample input"
            spellcheck="false"
          />
        </label>
        <span class="lg-verdict" />
        <span class="lg-tokens" />
      </div>
    )
  }
</div>

<style is:global>
  .live-grammar {
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    margin: 1.25rem 0;
    background: var(--bg);
    box-shadow: var(--shadow-card);
    font-family: var(--font-ui);
  }
  .lg-hd {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 0.85rem;
    background: var(--bg-1);
    border-bottom: 1px solid var(--border);
  }
  .lg-label {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--fg-faint);
    letter-spacing: 0.02em;
  }
  .lg-lab {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius);
  }
  .lg-lab:hover {
    background: var(--accent-softer);
  }
  .lg-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
  }
  @media (max-width: 640px) {
    .lg-grid {
      grid-template-columns: 1fr;
    }
  }
  .lg-src {
    border: 0;
    border-right: 1px solid var(--border);
    background: var(--bg);
    color: var(--fg);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.55;
    padding: 0.85rem;
    min-height: 190px;
    resize: vertical;
    width: 100%;
    outline: none;
    tab-size: 2;
  }
  .lg-src:focus {
    background: var(--accent-softer);
  }
  .lg-out {
    padding: 0.6rem 0.85rem;
    overflow: auto;
  }
  .lg-cap {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--fg-faint);
    margin-bottom: 0.4rem;
  }
  .lg-diagrams {
    display: grid;
    gap: 0.6rem;
  }
  .lg-diagrams .rr-figure {
    margin: 0;
    overflow: auto;
  }
  .lg-diagrams .rr-figure svg {
    max-width: 100%;
    height: auto;
  }
  .lg-diagrams figcaption {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--accent);
    margin-bottom: 0.2rem;
  }
  .lg-foot {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.55rem 0.85rem;
    border-top: 1px solid var(--border);
    background: var(--bg-1);
    flex-wrap: wrap;
  }
  .lg-input-wrap {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--fg-faint);
  }
  .lg-input {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    padding: 0.25rem 0.5rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: var(--bg);
    color: var(--fg);
    outline: none;
    min-width: 12ch;
  }
  .lg-input:focus {
    border-color: var(--accent);
  }
  .lg-verdict {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
  }
  .lg-verdict.ok {
    color: var(--accent);
  }
  .lg-verdict.no {
    color: #dc2626;
  }
  .lg-tokens {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--fg-faint);
  }
</style>

<script>
  import { parseGramarkDocument } from "../lib/gramark-runtime.ts";
  import { renderDiagrams } from "../lib/diagrams.ts";
  import { labGrammarHref } from "../lib/lab-link.ts";

  function wire(root: HTMLElement) {
    const base = root.dataset.base ?? "/";
    const src = root.querySelector<HTMLTextAreaElement>(".lg-src")!;
    const diagrams = root.querySelector<HTMLElement>(".lg-diagrams")!;
    const labLink = root.querySelector<HTMLAnchorElement>(".lg-lab")!;
    const input = root.querySelector<HTMLInputElement>(".lg-input");
    const verdict = root.querySelector<HTMLElement>(".lg-verdict");
    const tokens = root.querySelector<HTMLElement>(".lg-tokens");

    // Diagram nav (click a nonterminal → scroll to its rule) + click-to-zoom,
    // event-delegated so it survives re-render.
    diagrams.addEventListener("click", (event) => {
      const target = event.target as HTMLElement;
      const fig = target.closest<HTMLElement>(".rr-figure");
      if (fig) fig.classList.toggle("zoomed");
    });

    async function run() {
      const grammar = src.value;
      const sample = input ? input.value : undefined;
      labLink.href = labGrammarHref(base, grammar, sample);

      const result = await parseGramarkDocument(grammar, sample);

      const rules = result.rules;
      if (rules.length === 0) {
        diagrams.innerHTML =
          '<span style="color:var(--fg-faint);font-family:var(--font-mono);font-size:.75rem">— grammar did not parse</span>';
      } else {
        diagrams.innerHTML = renderDiagrams(grammar, rules)
          .map(
            (d) =>
              `<figure class="rr-figure" title="click to zoom"><figcaption>${d.name}</figcaption>${d.svg}</figure>`,
          )
          .join("");
      }

      if (verdict) {
        const ok = result.success;
        verdict.textContent = ok ? "✓ accepted" : "✕ rejected";
        verdict.className = "lg-verdict " + (ok ? "ok" : "no");
      }
      if (tokens) {
        tokens.textContent =
          result.tokens.length > 0 ? result.tokens.join(" · ") : "";
      }
    }

    const safeRun = () =>
      run().catch(() => {
        diagrams.textContent = "— engine error";
      });
    src.addEventListener("input", safeRun);
    input?.addEventListener("input", safeRun);
    safeRun();
  }

  document
    .querySelectorAll<HTMLElement>(".live-grammar")
    .forEach((el) => wire(el));
</script>
