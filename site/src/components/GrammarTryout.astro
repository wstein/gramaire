---
// A live "try it" panel, embeddable in Starlight MDX: a grammar editor beside
// its railroad diagrams, redrawn as you type by the *real* engine (the same
// `Gramark.Playground` core the CLI runs), plus — when a sample `input` is
// given — the accept/reject verdict. "Open in Lab ↗" hands the current grammar
// to the full Lab through the URL hash (see lab-link.ts). This is the design's
// "one file · edit the source" showcase, packaged for reuse in docs/tutorials.
//
// Usage in .mdx:
//   import GrammarTryout from "../../../components/GrammarTryout.astro";
//   <GrammarTryout grammar={`Expr\n  : Expr '+' Term\n  | Term\n`} input="num" />
import { labGrammarHref } from "../lib/lab-link.ts";

interface Props {
  /** The seed grammar (`.grmk` projection or fenced `.grmk.md`). */
  grammar: string;
  /** Optional sample input; when present, shows a live accept/reject verdict. */
  input?: string;
  /** Header label; defaults to the design's "try it — live". */
  caption?: string;
}

const { grammar, input, caption = "try it — live" } = Astro.props as Props;
const labHref = labGrammarHref(import.meta.env.BASE_URL, grammar, input);
const hasInput = input != null;
---

<div class="gramark-tryout" data-has-input={hasInput ? "1" : "0"}>
  <div class="tryout-hd">
    <span class="tryout-label">{caption}</span>
    <a class="tryout-lab" href={labHref}>Open in Lab ↗</a>
  </div>
  <div class="tryout-grid">
    <textarea class="tryout-src" spellcheck="false" aria-label="Grammar source"
      >{grammar}</textarea
    >
    <div class="tryout-out">
      <div class="tryout-cap">renders to ↓</div>
      <div class="tryout-diagrams">—</div>
    </div>
  </div>
  {
    hasInput && (
      <div class="tryout-foot">
        <label class="tryout-input-wrap">
          <span>input</span>
          <input class="tryout-input" value={input} aria-label="Sample input" />
        </label>
        <span class="tryout-verdict" />
      </div>
    )
  }
</div>

<style is:global>
  .gramark-tryout {
    border: 1px solid var(--sl-color-gray-5, #e5e7eb);
    border-radius: 0.75rem;
    overflow: hidden;
    margin: 1.25rem 0;
    background: var(--sl-color-bg, #fff);
  }
  .gramark-tryout .tryout-hd {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.5rem 0.85rem;
    border-bottom: 1px solid var(--sl-color-gray-5, #e5e7eb);
    background: var(--sl-color-gray-6, #f5f6f3);
  }
  .gramark-tryout .tryout-label {
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3, #7d8d85);
  }
  .gramark-tryout .tryout-lab {
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.72rem;
    font-weight: 500;
    text-decoration: none;
    color: var(--sl-color-accent, #15b879);
    border: 1px solid
      color-mix(in srgb, var(--sl-color-accent, #15b879) 30%, transparent);
    background: color-mix(
      in srgb,
      var(--sl-color-accent, #15b879) 8%,
      transparent
    );
    padding: 0.25rem 0.6rem;
    border-radius: 0.4rem;
    white-space: nowrap;
  }
  .gramark-tryout .tryout-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  .gramark-tryout .tryout-src {
    border: 0;
    border-right: 1px solid var(--sl-color-gray-5, #e5e7eb);
    resize: vertical;
    padding: 0.85rem 1rem;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.8rem;
    line-height: 1.65;
    background: var(--sl-color-bg, #fff);
    color: var(--sl-color-text, #1f3a31);
    min-height: 190px;
    outline: none;
  }
  .gramark-tryout .tryout-src:focus {
    box-shadow: inset 2px 0 0 var(--sl-color-accent, #15b879);
  }
  .gramark-tryout .tryout-out {
    padding: 0.85rem 1rem;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .gramark-tryout .tryout-cap {
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.68rem;
    color: var(--sl-color-gray-3, #7d8d85);
    margin-bottom: 0.75rem;
  }
  .gramark-tryout .tryout-diagrams {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    justify-content: center;
    overflow: auto;
  }
  .gramark-tryout .tryout-foot {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    padding: 0.6rem 0.85rem;
    border-top: 1px solid var(--sl-color-gray-5, #e5e7eb);
    background: var(--sl-color-gray-6, #f5f6f3);
  }
  .gramark-tryout .tryout-input-wrap {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.75rem;
    color: var(--sl-color-gray-3, #7d8d85);
  }
  .gramark-tryout .tryout-input {
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.8rem;
    padding: 0.25rem 0.5rem;
    border: 1px solid var(--sl-color-gray-5, #e5e7eb);
    border-radius: 0.4rem;
    background: var(--sl-color-bg, #fff);
    color: var(--sl-color-text, #1f3a31);
    min-width: 12rem;
  }
  .gramark-tryout .tryout-verdict {
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.78rem;
    font-weight: 600;
  }
  .gramark-tryout .tryout-verdict.ok {
    color: var(--sl-color-accent, #15b879);
  }
  .gramark-tryout .tryout-verdict.bad {
    color: #dc2626;
  }

  /* Railroad SVGs are injected at runtime, so their styling must be global.
     renderSvg embeds light-theme colours; nudge them for Starlight dark mode. */
  .gramark-tryout .rr-figure {
    margin: 0;
  }
  .gramark-tryout .rr-figure svg {
    max-width: 100%;
    height: auto;
  }
  .gramark-tryout .rr-figure figcaption {
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--sl-color-accent, #15b879);
    margin-bottom: 0.25rem;
  }
  [data-theme="dark"] .gramark-tryout .rr-figure .rr-text {
    fill: var(--sl-color-white, #eaf2ed);
  }
  [data-theme="dark"] .gramark-tryout .rr-figure .rr-nonterm {
    fill: var(--sl-color-gray-6, #1a2620);
    stroke: var(--sl-color-gray-3, #8ea298);
  }
  [data-theme="dark"] .gramark-tryout .rr-figure .rr-cap {
    fill: var(--sl-color-white, #eaf2ed);
  }
  [data-theme="dark"] .gramark-tryout .rr-figure .rr-track {
    stroke: var(--sl-color-gray-4, #73877e);
  }

  @media (max-width: 640px) {
    .gramark-tryout .tryout-grid {
      grid-template-columns: 1fr;
    }
    .gramark-tryout .tryout-src {
      border-right: 0;
      border-bottom: 1px solid var(--sl-color-gray-5, #e5e7eb);
    }
  }
</style>

<script>
  import { parseGramarkDocument } from "../lib/gramark-runtime.ts";
  import { renderDiagrams } from "../lib/diagrams.ts";

  // Wire every embedded tryout on the page (a docs page may hold several). The
  // seed grammar/input live in the DOM, so no per-instance server data needed.
  function wire(root) {
    const src = root.querySelector(".tryout-src");
    const diagramsEl = root.querySelector(".tryout-diagrams");
    const inputEl = root.querySelector(".tryout-input");
    const verdictEl = root.querySelector(".tryout-verdict");
    if (!src || !diagramsEl) return;

    async function render() {
      let result;
      try {
        result = await parseGramarkDocument(src.value, inputEl?.value ?? "");
      } catch {
        diagramsEl.textContent = "—";
        return;
      }
      const diagrams = result.rules.length
        ? renderDiagrams(src.value, result.rules)
        : [];
      diagramsEl.innerHTML = diagrams.length
        ? diagrams
            .map(
              (d) =>
                `<figure class="rr-figure"><figcaption>${d.name}</figcaption>${d.svg}</figure>`,
            )
            .join("")
        : `<span style="color:var(--sl-color-gray-3);font-family:'IBM Plex Mono',monospace;font-size:0.75rem">keep typing — no rule to draw yet</span>`;

      if (verdictEl && inputEl) {
        if (!inputEl.value.trim()) {
          verdictEl.textContent = "";
          verdictEl.className = "tryout-verdict";
        } else {
          verdictEl.textContent = result.success ? "✓ accepted" : "✗ rejected";
          verdictEl.className =
            "tryout-verdict " + (result.success ? "ok" : "bad");
        }
      }
    }

    let pending = 0;
    const schedule = () => {
      clearTimeout(pending);
      pending = window.setTimeout(render, 160);
    };
    src.addEventListener("input", schedule);
    inputEl?.addEventListener("input", schedule);
    render();
  }

  for (const el of document.querySelectorAll(".gramark-tryout")) wire(el);
</script>
