---
// A glossary term with a hover definition. Usage in MDX:
//   <Term name="shift-reduce">shift/reduce conflict</Term>
// Renders a native <abbr> (accessible, no JS); the dotted underline cues that a
// definition is available on hover.
import { glossary } from "./glossary.ts";

interface Props {
  name: string;
}

const { name } = Astro.props;
const def = glossary[name];
if (!def) {
  throw new Error(
    `<Term name="${name}">: no such glossary entry (see src/components/glossary.ts)`,
  );
}
---

<abbr
  title={def}
  style="text-decoration-line: underline; text-decoration-style: dotted; text-underline-offset: 3px; cursor: help;"
  ><slot /></abbr
>
