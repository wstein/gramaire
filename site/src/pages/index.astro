---
// The Landing page — rendered through Starlight's own page pipeline
// (`<StarlightPage template="splash">`) instead of as a bare Astro page
// outside it. It used to be bare, same reasoning as src/pages/lab.astro
// (this page's own custom layout doesn't fit Starlight's sidebar/prose
// content model) — but that meant Home never loaded Starlight's own CSS
// bundle or `--sl-*` variable definitions, which caused two real,
// hard-to-reproduce bugs (the search shortcut badge, the topbar's sticky
// positioning) that had to be patched with page-agnostic overrides in
// starlight-bridge.css and gramaire-topbar.mjs. `<StarlightPage>` gets Home
// the exact same bundle, `<ThemeProvider>`, and Header wiring Docs/Specs/
// Tutorials/Brand already have, for free — see docs/topbar-styles-sharing-
// audit.md for the fuller comparison this grew out of.
//
// `template: "splash"` drops the sidebar/table-of-contents; `PageTitle`
// and `Footer` are suppressed for this route specifically (see
// src/components/overrides/PageTitle.astro and Footer.astro) since this
// page's hero heading and footer replace Starlight's own. Layout/copy/
// values ported verbatim from the gold-standard mock's `homeView()`
// (design/gramark-site-handoff/Gramaire Site.dc.html).
//
// The mock's showcase is *live* (editable, re-parses on keystroke) because
// it's backed by its stand-in engine — `design/README.md`'s gold-standard
// boundary is explicit that stand-in (`support.js`, an Earley parser with
// eval()-based actions) is reference-only, never ported, never imported
// from site code. The code panel below stays static (matching the mock's
// contractual LAYOUT — a static code block is not something "that would
// change if you swapped the input grammar," so it's fair game to leave
// alone), but the "try it" strip beneath the diagram is now genuinely live,
// on the real engine: `HomeCalcTryIt` reuses the same `createLabWorker`
// the Gramaire Notebook does. divergence: embeds a real preview island on
// Landing, closing the increment this file's own comment used to defer.
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import Button from "../components/Button.astro";
import FeatureTile from "../components/FeatureTile.astro";
import { HomeCalcTryIt } from "../lab/HomeCalcTryIt";

// Byte-identical to examples/calc-js.gram.md's own Expr rule — real, working syntax (the mock's
// original `{% Add %}`/`{% Sub %}` bare-identifier actions were never valid: BackendJs has no
// bare-identifier-as-function-call support, and would reference an undefined name at runtime).
const showcaseSource = `Expr
  : Expr '+' Term   {% (c) => c.expr + c.term %}
  | Expr '-' Term   {% (c) => c.expr - c.term %}
  | Term`;

// Astro does not rewrite hand-written root-absolute href strings under the
// configured `base` (only its own href/src template attributes get that
// treatment) — a real bug the CI build (base "/gramaire/") would otherwise
// ship: these links would 404 on GitHub Pages. Resolve from BASE_URL instead.
const base = import.meta.env.BASE_URL;
---

<StarlightPage
  frontmatter={{
    title: "Gramaire — Grammars that render themselves.",
    description: "Grammars that render themselves.",
    template: "splash",
    tableOfContents: false,
    editUrl: false,
  }}
>
  <div class="container">
    <div class="hero">
      <div class="hero__eyebrow">
        LR parser generator · source format is Markdown
      </div>
      <h1 class="hero__title">
        Grammars that <span class="hero__title-accent">render themselves.</span>
      </h1>
      <p class="hero__sub">
        A .gram.md file is a normal Markdown document — it renders on GitHub as
        prose, railroad diagrams, and FIRST/FOLLOW tables — and is <strong
          >at the same time</strong
        > the exact input the parser generator reads. Your grammar <em>is</em> your
        documentation.
      </p>
      <div class="hero__buttons">
        <Button kind="primary" href={`${base}tutorials/intro/`}
          >Start the tutorial <span class="hero__arrow">→</span></Button
        >
        <Button kind="ghost" href={`${base}lab/`}>Open the Lab</Button>
      </div>
    </div>

    <div class="showcase">
      <div class="showcase__header">
        <span class="showcase__label">one file · live — edit the source</span>
        <Button kind="chip" href={`${base}lab/`}>Open in Lab ↗</Button>
      </div>
      <div class="showcase__body">
        <pre class="showcase__source"><code>{showcaseSource}</code></pre>
        <div class="showcase__diagram">
          <div class="showcase__diagram-label">renders to ↓</div>
          <div class="showcase__diagram-svg">
            <img
              src={`${base}diagrams-calc/expr.svg`}
              alt="Railroad diagram for the Expr rule"
            />
          </div>
          <HomeCalcTryIt client:idle />
        </div>
      </div>
    </div>

    <div class="tiles">
      <FeatureTile
        big="3×"
        small="parse-table methods — canonical LR(1), LALR(1), IELR(1)"
      />
      <FeatureTile
        big="1 file"
        small="grammar and docs are the same .gram.md"
      />
      <FeatureTile
        big="closed"
        small="the self-hosting loop — it reads its own notation back"
      />
      <FeatureTile
        big="Notebook"
        small="prose, grammar cells, and live outputs in one scrolling document — the Gramaire Notebook"
      />
    </div>

    <footer class="footer">
      <span>Gramaire · Apache-2.0</span>
      <a href={`${base}docs/overview/`}>Docs</a>
      <a href={`${base}tutorials/intro/`}>Tutorial</a>
      <a href={`${base}lab/`}>Lab</a>
      <a href={`${base}notebook/`}>Notebook</a>
      <a
        href="https://github.com/wstein/gramaire"
        target="_blank"
        rel="noreferrer">GitHub ↗</a
      >
    </footer>
  </div>
</StarlightPage>

<style>
  /*
   * Keeps Home's own reading measure (960px) narrower than Starlight's
   * `--sl-content-width` (67.5rem/1080px for a sidebar-less `splash`
   * template) — same width this page used before it ran through
   * Starlight's own ContentPanel, which already supplies vertical padding
   * (`--sl-content-pad-x`/1.5rem) around this.
   */
  .container {
    max-width: 960px;
    margin: 0 auto;
  }
  .hero {
    text-align: center;
  }
  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--accent);
    background: var(--accent-softer);
    border: 1px solid color-mix(in srgb, var(--accent) 24%, transparent);
    border-radius: 999px;
    padding: 6px 13px;
    margin-bottom: 24px;
  }
  .hero__title {
    font-size: 56px;
    line-height: 1.04;
    letter-spacing: -2px;
    font-weight: 700;
    margin: 0 auto 20px;
    max-width: 760px;
  }
  .hero__title-accent {
    color: var(--accent);
  }
  .hero__sub {
    font-size: 18px;
    line-height: 1.6;
    color: var(--fg-muted);
    max-width: 620px;
    margin: 0 auto 30px;
  }
  .hero__buttons {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }
  .hero__arrow {
    font-family: var(--font-mono);
  }

  .showcase {
    margin-top: 56px;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-card);
  }
  .showcase__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 16px;
    border-bottom: 1px solid var(--border);
    background: var(--bg-1);
  }
  .showcase__label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-faint);
  }
  .showcase__body {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  .showcase__source {
    margin: 0;
    border-right: 1px solid var(--border);
    padding: 20px 22px;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.7;
    background: var(--bg);
    color: var(--fg-secondary);
    min-height: 190px;
    white-space: pre-wrap;
  }
  .showcase__diagram {
    padding: 20px 22px;
    display: flex;
    flex-direction: column;
  }
  .showcase__diagram-label {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--fg-faint);
    margin-bottom: 14px;
  }
  .showcase__diagram-svg {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .showcase__diagram-svg img {
    max-width: 100%;
    height: auto;
  }

  .tiles {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: 24px;
  }

  .footer {
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
    display: flex;
    gap: 18px;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--fg-faint);
    flex-wrap: wrap;
  }
  .footer a {
    color: inherit;
    text-decoration: none;
  }
  .footer a:hover {
    color: var(--accent);
  }
</style>
