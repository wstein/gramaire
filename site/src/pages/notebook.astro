---
// Grimoire Notebook — a standalone page, deliberately separate from lab.astro (see
// docs/rebrand-grimoire-plan.md and site/src/lab/liveDoc/GrimoireNotebookIsland.tsx's own
// header comment for why this isn't a mode bolted onto the existing Lab). Bare Astro page
// outside the Starlight shell, same reasoning as lab.astro/index.astro.
import AppShell from "../components/AppShell.astro";
import {
  GrimoireNotebookIsland,
  NotebookTopbarTools,
} from "../lab/liveDoc/GrimoireNotebookIsland";
import { pageHeadTags } from "../shared/page-head.mjs";
import "../styles/tokens.css";
import "../styles/starlight-bridge.css";

const base = import.meta.env.BASE_URL;
const headTags = pageHeadTags(base);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {
      /* Same FOUC-prevention seed as lab.astro/index.astro — this page also sits outside
         Starlight's Page.astro/ThemeProvider. */
    }
    <script is:inline>
      (() => {
        const stored = localStorage.getItem("starlight-theme");
        const theme =
          stored === "light" || stored === "dark"
            ? stored
            : matchMedia("(prefers-color-scheme: light)").matches
              ? "light"
              : "dark";
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <title>Gramark — Grimoire Notebook</title>
    <meta
      name="description"
      content="Edit a Gramark grammar as a live document — prose and editable grammar cells inline, with railroad diagrams and FIRST/FOLLOW sets updating as you type."
    />
    {headTags.map((t) => t.tag === "link" && <link {...t.attrs} />)}
  </head>
  <body>
    <div class="shell">
      <AppShell>
        <NotebookTopbarTools slot="page-tools" client:load />
      </AppShell>
      <main class="content">
        <GrimoireNotebookIsland client:load />
      </main>
    </div>
  </body>
</html>

<style>
  :global(html, body) {
    margin: 0;
    height: 100%;
  }
  :global(body) {
    background: var(--bg);
    color: var(--fg);
    font-family: var(--font-ui);
    -webkit-font-smoothing: antialiased;
  }
  .shell {
    height: 100vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .content {
    flex: 1;
    min-height: 0;
  }

  /* The "Print / PDF" download action (DownloadActions, GrimoireNotebookIsland.tsx) always
     switches to Paper first, then calls window.print() — this is what that print actually looks
     like. Lives here, not in the reusable grimoireNotebook.css: that file is also imported by the
     homepage's embedded showcase card (index.astro), which has none of THIS page's own
     .shell/.content/shared-topbar structure to reset — a print stylesheet that hides
     gramark-topbar and resets .shell's height:100vh;overflow:hidden belongs to the PAGE, not the
     reusable feature CSS. :global() for every selector below: none of `.grimoire`'s own render
     tree is part of THIS component's template (it's a separate Preact island), so Astro's default
     scoping — which only scopes selectors matching elements literally written in ITS OWN
     template — would otherwise silently never match any of it (same reasoning this file's own
     :global(html, body) rule above already relies on, just for more selectors). */
  @media print {
    :global(gramark-topbar),
    :global(.grimoire__statusbar),
    :global(.grimoire__diagnostics) {
      display: none !important;
    }
    /* Otherwise the printed output clips to one screen's worth of content instead of flowing
       across physical pages — a real, easy-to-miss failure mode (this page's own fixed-shell
       layout is exactly what makes the Notebook body scroll internally in the browser), not a
       hypothetical one. */
    .shell,
    .content {
      height: auto;
      overflow: visible;
    }
    :global(.grimoire),
    :global(.grimoire__body),
    :global(.grimoire__doc) {
      height: auto !important;
      overflow: visible !important;
    }
    :global(.grimoire__paper) {
      max-width: none;
      margin: 0;
    }
    :global(.grimoire__paper-figure) {
      break-inside: avoid;
    }
  }
</style>
