{
  "name": "gramaire-bootstrap",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Disposable TypeScript bridge implementing `gramaire --check` until the PureScript core is self-hosting.",
  "bin": {
    "gramaire": "./gramaire-check.ts"
  },
  "scripts": {
    "check": "node gramaire-check.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test gramaire-check.test.ts railroad.test.ts analyze.test.ts emitted-parser.test.ts",
    "lint:md": "node lint-docs.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^24",
    "markdownlint-cli2": "^0.22",
    "prettier": "^3",
    "typescript": "^5"
  }
}
