# Node (bootstrap bridge)
node_modules/

# sbt / Scala build output
target/
project/target/
project/project/
.bsp/
.bloop/
.metals/
.vscode/
metals.sbt

# Editor / OS
.DS_Store

scratchpad/

# Metals build artifacts
.metals/metals.lock.db

# Astro / site build output
site/dist/
site/.astro/

# The compiled Scala.js `lab` engine bundle site/src/lab/worker.ts loads at
# runtime — generated by `npm run build:engine` (site/scripts/build-
# engine.mjs), never committed (docs/playground-spec.md: "placeholder
# locally, CI builds the real one"). Lives in public/ (copied verbatim by
# Astro's build, never run through Vite's JS pipeline) deliberately, not
# src/ — see worker.ts's own comment for why a static src/ import broke it.
site/public/lab/engine.mjs

# The homepage's build-time-prerendered Notebook response — generated from the above engine
# bundle by `npm run prerender:notebook` (site/scripts/prerender-notebook.mjs), never committed
# for the same reason: it's derived output, not source.
site/src/lab/liveDoc/notebookPrerender.generated.json

# Playwright (site/ visual tests) — reports and diffs are local-only;
# snapshot baselines under tests/visual/**/*-snapshots/ ARE committed
site/test-results/
site/playwright-report/
site/blob-report/

# Bun lockfile
bun.lock

# Derived raw grammar projections (`gramark strip`); never authoritative for a `.grmk.md` that
# has one (ADR D36) — regenerate with `make strip`/`make strip-examples`, don't commit them. A
# standalone, hand-authored `.grmk` with no `.grmk.md` sibling is first-class (GramarkCheck's
# native check/fmt/lock gate) and IS meant to be committed — list each one here as an explicit
# `!` exception, kept in sync with GramarkCheckSuite.scala's `nativeGatedFiles`.
*.grmk
!examples/lua.grmk

# codegen-scratch: a throwaway compile target for the scala-peg backend's parity gate
# (site/scripts/check-scala-peg-parity.mjs). Generated.scala is (re)written by
# ScalaPegParityMain before every run; vectors.txt is its own input/output line-protocol file.
# Neither is ever authoritative — only codegen-scratch/src/main/scala/gramark/scratch/Main.scala
# (the fixed driver) is committed.
codegen-scratch/src/main/scala/gramark/scratch/Generated.scala
codegen-scratch/vectors.txt

# Python
__pycache__/
