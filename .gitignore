# Node (bootstrap bridge)
node_modules/

# sbt / Scala build output
target/
project/target/
project/project/
.bsp/
.bloop/
.metals/
.vscode/
metals.sbt

# Editor / OS
.DS_Store

scratchpad/

# Metals build artifacts
.metals/metals.lock.db

# Astro / site build output
site/dist/
site/.astro/

# The compiled Scala.js `lab` engine bundle site/src/lab/worker.ts loads at
# runtime — generated by `npm run build:engine` (site/scripts/build-
# engine.mjs), never committed (docs/playground-spec.md: "placeholder
# locally, CI builds the real one"). Lives in public/ (copied verbatim by
# Astro's build, never run through Vite's JS pipeline) deliberately, not
# src/ — see worker.ts's own comment for why a static src/ import broke it.
site/public/lab/engine.mjs

# Playwright (site/ visual tests) — reports and diffs are local-only;
# snapshot baselines under tests/visual/**/*-snapshots/ ARE committed
site/test-results/
site/playwright-report/
site/blob-report/

# Bun lockfile
bun.lock

# Derived raw grammar projections (`gramaire strip`); never authoritative for a `.gram.md` that
# has one (ADR D36) — regenerate with `make strip`/`make strip-examples`, don't commit them. A
# standalone, hand-authored `.gram` with no `.gram.md` sibling is first-class (GramaireCheck's
# native check/fmt/lock gate) and IS meant to be committed — list each one here as an explicit
# `!` exception, kept in sync with GramaireCheckSuite.scala's `nativeGatedFiles`.
*.gram
!examples/lua.gram
